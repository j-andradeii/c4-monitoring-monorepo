{
  "name": "c4-monitoring-monorepo",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build common && npx tsc",
    "build:church": "nest build church && npx tsc --project apps/church/tsconfig.app.json",
    "build:members": "nest build members && npx tsc --project apps/members/tsconfig.app.json",
    "build:gateway": "nest build api-gateway && npx tsc --project apps/api-gateway/tsconfig.app.json",
    "build:auth": "nest build auth && npx tsc --project apps/auth/tsconfig.app.json",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "typeorm:church": "typeorm-ts-node-commonjs -d apps/church/src/orm-config.ts",
    "typeorm:prod:church": "cross-env NODE_ENV=production typeorm -d dist/apps/church/apps/church/src/orm-config.js",
    "migration:create:church": "npm run build:church &&  npm run typeorm:church -- migration:create apps/church/src/db/migrations/ChurchMigrationName",
    "migration:generate:church": "npm run build:church && npm run typeorm:church -- migration:generate apps/church/src/db/migrations/ChurchMigrationName",
    "migration:run:church": "npm run build:church && npm run typeorm:church migration:run",
    "migration:prod:run:church": "npm run build:church && npm run typeorm:prod:church migration:run",
    "typeorm:members": "typeorm-ts-node-commonjs -d apps/members/src/orm-config.ts",
    "typeorm:prod:members": "cross-env NODE_ENV=production typeorm -d dist/apps/members/apps/members/src/orm-config.js",
    "migration:create:members": "npm run build:members && npm run typeorm:members -- migration:create apps/members/src/db/migrations/MembersMigrationName",
    "migration:generate:members": "npm run build:members && npm run typeorm:members -- migration:generate apps/members/src/db/migrations/MembersMigrationName",
    "migration:run:members": "npm run build:members && npm run typeorm:members migration:run",
    "migration:prod:run:members": "npm run build:members && npm run typeorm:prod:members migration:run",
    "start:auth": "nodemon --watch 'apps/auth/src/**' --exec 'ts-node -r tsconfig-paths/register' apps/auth/src/main.ts",
    "start:church": "nodemon --watch 'apps/church/src/**' --exec 'ts-node -r tsconfig-paths/register' apps/church/src/main.ts",
    "start:members": "nodemon --watch 'apps/members/src/**' --exec 'ts-node -r tsconfig-paths/register' apps/members/src/main.ts",
    "start:gateway": "nodemon --watch 'apps/api-gateway/src/**' --exec 'ts-node -r tsconfig-paths/register' apps/api-gateway/src/main.ts",
    "railway:deploy:members": "npm run migration:prod:run:members && npm run start:prod:members",
    "railway:deploy:church": "npm run migration:prod:run:church && npm run start:prod:church",
    "railway:deploy:auth": "npm run start:prod:auth",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod:gateway": "node dist/apps/api-gateway/main.js",
    "start:prod:auth": "node dist/apps/auth/main.js",
    "start:prod:church": "node dist/apps/church/main.js",
    "start:prod:members": "node dist/apps/members/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/c4-monitoring-monorepo/test/jest-e2e.json",
    "generate:dto-index": "barrelsby -d libs/libs/src/dto -e index\\.ts -D -l top"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^10.2.7",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^10.4.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "barrelsby": "^2.8.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/libs(|/.*)$": "<rootDir>/libs/libs/src/$1"
    }
  }
}
