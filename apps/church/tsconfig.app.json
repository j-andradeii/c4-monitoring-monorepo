{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "outDir": "../../dist/apps/church",
    "rootDir": "./src",                // Ensure root directory is src
    "module": "commonjs",
    "target": "es6",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],         // Make sure your types include node and jest/mocha if you're using them
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],          // Include all .ts files under src
  "exclude": ["node_modules", "dist"]  // Exclude node_modules and dist
}
